# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Output of the optional browser checks (visualizer/check_web_*.py)
.browser_checks/

# Trained checkpoints of all studies are tracked; per-run training logs are not.
*.pth
results/*/checkpoints/*.log
results/*/checkpoints/*.lock
results/*/evaluations/*.log

# Logs of local command-line runs (historical tracked logs are unaffected)
results/*_run*.log

# Timing probe and interrupted source-archive batch; excluded from submission.
results/runtime_probe/
results/final_study/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
