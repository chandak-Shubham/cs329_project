# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Per-run logs and locks written during training and evaluation
models/*/*.log
models/*/*.lock
results/*/evaluations/*.log
results/*_run*.log

# Output of the optional browser checks (frontend/check_web_*.py)
.browser_checks/

# Locally built GitHub Pages site (frontend/build_site.py; CI builds its own)
_site/

# LaTeX build files (compile report/final_report.tex on Overleaf or locally)
report/*.aux
report/*.log
report/*.out
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
